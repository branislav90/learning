{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "inputs": ["src/**","package.json","tsconfig*.json","!**/*.test.*"], "outputs": ["dist/**",".next/**","!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"], "inputs": ["src/**","tsconfig*.json"] },
    "test": { "dependsOn": ["^build"], "inputs": ["src/**","vitest.config.*"], "env": ["CI"] },
    "lint": { "inputs": ["src/**","eslint.config.*"] },
    "dev": { "cache": false, "persistent": true }
  }
}
